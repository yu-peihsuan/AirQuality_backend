# 環境部空氣品質 API 金鑰 (請替換為自己的申請金鑰)
MOENV_API_KEY=your_api_key_here

# 中央氣象署 API 金鑰 (請替換為自己的申請金鑰)
CWA_API_KEY=your_cwa_api_key_here

# OpenRouter API 金鑰（用於 LLM 語意結構化、RAG 建議生成、Embedding）
OPENROUTER_API_KEY=your_openrouter_api_key_here

# JWT 簽章密鑰（裝置認證用）。請自行產生一組長度足夠的隨機字串：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# 未設定時服務仍可啟動並提供公開資料，但所有需認證的端點一律回 500。
JWT_SECRET=your_jwt_secret_here

# 管理端點密鑰（手動推播、推播測試、RAG 實驗）。未設定時這些端點一律拒絕。
ADMIN_TOKEN=your_admin_token_here
